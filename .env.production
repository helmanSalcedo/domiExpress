# ======================
# DATABASE (CRÍTICO)
# ======================
DATABASE_URL="postgresql://user:password123@localhost:5432/domiexpress"
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"

# ======================
# JWT (GENERA UNO!)
# ======================
JWT_SECRET="your-super-secret-jwt-key-should-be-256-chars-minimum-asdfjklqwerty123456789abcdefghijklmnopqrstuvwxyz"
JWT_EXPIRATION="24h"

# ======================
# WOMPI (Pagos)
# OBTENER DE: https://wompi.co
# ======================
WOMPI_API_KEY="test_integrity_e8a8f31f-cfad-423e-93e5-c4b0d86e52e9"
WOMPI_PRIVATE_KEY="prv_test_e8a8f31f-cfad-423e-93e5-c4b0d86e52e9"
WOMPI_PUBLIC_KEY="pub_test_e8a8f31f-cfad-423e-93e5-c4b0d86e52e9"
WOMPI_WEBHOOK_SECRET="webhook_secret_test_12345"
WOMPI_ENVIRONMENT="test"

# ======================
# FIREBASE (Push Notifications)
# OBTENER DE: https://console.firebase.google.com
# 1. Crear proyecto
# 2. Habilitar Cloud Messaging
# 3. Crear service account
# 4. Descargar JSON y llenar estos campos
# ======================
FIREBASE_TYPE="service_account"
FIREBASE_PROJECT_ID="domiexpress-dev"
FIREBASE_PRIVATE_KEY_ID="key-id-xxxxx"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQDU8HJ2xT5lYd5b\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@domiexpress-dev.iam.gserviceaccount.com"
FIREBASE_CLIENT_ID="123456789"
FIREBASE_AUTH_URI="https://accounts.google.com/o/oauth2/auth"
FIREBASE_TOKEN_URI="https://oauth2.googleapis.com/token"
FIREBASE_AUTH_PROVIDER_CERT_URL="https://www.googleapis.com/oauth2/v1/certs"
FIREBASE_CLIENT_CERT_URL="https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk%40domiexpress-dev.iam.gserviceaccount.com"

# ======================
# SENDGRID (Email)
# OBTENER DE: https://sendgrid.com
# 1. Crear cuenta
# 2. Ir a Settings → API Keys
# 3. Generar nueva API Key
# ======================
SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SENDGRID_FROM_EMAIL="noreply@domiexpress.com"
SENDGRID_FROM_NAME="DomiExpress"

# ======================
# WHATSAPP BUSINESS API
# OBTENER DE: https://developers.facebook.com
# 1. Crear Business Account
# 2. Solicitar acceso a WhatsApp Business API
# 3. Crear número de teléfono
# ======================
WHATSAPP_API_TOKEN="EAABsbCS1iHgBO0ZAZBfZCxxxxxxxxxxx"
WHATSAPP_BUSINESS_ACCOUNT_ID="123456789"
WHATSAPP_PHONE_NUMBER_ID="1234567890"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-webhook-token-here"

# ======================
# CLAUDE AI API (Para Chatbot)
# OBTENER DE: https://console.anthropic.com
# ======================
CLAUDE_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLAUDE_MODEL="claude-opus-5"

# ======================
# APPLICATION
# ======================
NODE_ENV="development"
PORT=3000
LOG_LEVEL="debug"
CORS_ORIGIN="http://localhost:3001,http://localhost:3000,http://localhost:5555"

# ======================
# RATE LIMITING
# ======================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ======================
# AWS S3 (Para uploads de fotos)
# OPCIONAL
# ======================
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="xxxxx"
# AWS_SECRET_ACCESS_KEY="xxxxx"
# AWS_S3_BUCKET="domiexpress-uploads"

# ======================
# DATADOG (Monitoring)
# OPCIONAL
# ======================
