# ======================
# DomiExpress Docker Environment Configuration
# ======================
# Copy this file to .env.docker and customize for your environment
# Used by docker-compose.yml with: docker-compose --env-file .env.docker up

# ======================
# Application
# ======================
NODE_ENV=development
APP_PORT=3000
LOG_LEVEL=debug

# ======================
# Database (PostgreSQL) - Using local database
# ======================
# Change DB_HOST to your local machine IP if needed (e.g., 192.168.1.100)
# Or use 'host.docker.internal' on Windows/Mac to access host machine
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=domiexpress

# Test Database
TEST_DB_PORT=5433
TEST_DB_PASSWORD=domiexpress_test_pass
TEST_DB_NAME=domiexpress_test

# ======================
# Cache & Queue (Redis)
# ======================
REDIS_URL=redis://redis:6379
REDIS_PORT=6379
REDIS_PASSWORD=
TEST_REDIS_PORT=6380

