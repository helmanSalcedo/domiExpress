# Database
DATABASE_URL="postgresql://domiexpress:domiexpress_dev_pass@localhost:5432/domiexpress_dev"
DATABASE_URL_TEST="postgresql://domiexpress:domiexpress_test_pass@localhost:5433/domiexpress_test"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars-1234567890"
JWT_EXPIRATION="24h"

# Node Environment
NODE_ENV="development"
PORT=3000

# WhatsApp API
WHATSAPP_API_URL="https://graph.instagram.com/v18.0"
WHATSAPP_API_KEY="your-whatsapp-business-api-key"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"

# Claude AI API (for NLU)
CLAUDE_API_KEY="your-claude-api-key-sk-..."
CLAUDE_MODEL="claude-opus-5"

# Wompi Payment
WOMPI_API_URL="https://api.wompi.co/v1"
WOMPI_PUBLIC_KEY="pub_prod_xxxxx"
WOMPI_PRIVATE_KEY="prv_prod_xxxxx"

# Redis (for real-time features)
REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379

# AWS S3 (for file uploads)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET="domiexpress-uploads"

# Logging
LOG_LEVEL="debug"

# CORS
CORS_ORIGIN="http://localhost:3001,http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
